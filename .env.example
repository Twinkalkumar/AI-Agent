# Copy this file to .env and fill in real values. Never commit .env itself
# (add it to .gitignore) since it holds a real API key.

# --- Choose the backend ---
# "ollama" = fully local (default, no key needed)
# "openai" = cloud API (OpenAI, or any OpenAI-compatible provider)
LLM_PROVIDER=ollama

# --- Only needed if LLM_PROVIDER=openai ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Optional: point at an OpenAI-compatible provider instead of api.openai.com
# e.g. Groq:      https://api.groq.com/openai/v1   (model: llama-3.3-70b-versatile)
# e.g. Together:  https://api.together.xyz/v1
# OPENAI_BASE_URL=

# --- Only needed for the github_assistant task ---
# Create a token at https://github.com/settings/tokens (fine-grained tokens
# recommended — scope it to just the specific repo(s) you want the agent
# to touch, with Contents: Read and write).
GITHUB_TOKEN=ghp_...
# Optional: lets you write "reponame" instead of "yourusername/reponame"
GITHUB_DEFAULT_OWNER=your-github-username
